# FitPulse Backend Environment Configuration Template
# Duplicate this file to .env and configure values for your environment.

# Server Configuration
PORT=5000
NODE_ENV=development

# JSON Web Token Secret & Expiration
# In production, use a high-entropy 256-bit or 512-bit random string
JWT_SECRET=replace_with_a_secure_jwt_secret_in_production
JWT_EXPIRES_IN=7d

# Relational Database Connection URL
# SQLite Local (Default zero-config): file:./dev.db
# PostgreSQL: postgresql://username:password@localhost:5432/fitpulse_db?schema=public
DATABASE_URL="file:./dev.db"

# CORS Allowed Origin
FRONTEND_URL=http://localhost:5173
